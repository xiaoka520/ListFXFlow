<Window x:Class="ListFXFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ListFXFlow" Title="ListFXFlow" Width="1120" Height="880" MinWidth="990" MinHeight="760" Background="#0C0E15" WindowStartupLocation="CenterScreen">
<Window.Resources>
    <DrawingBrush x:Key="DotGrid" TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,18,18"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#1AFFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="9,9" RadiusX="1.4" RadiusY="1.4"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#11131D" BorderBrush="#232634" BorderThickness="0,0,1,0">
      <Grid Margin="20,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><local:FlowIcon Kind="Pointer" Stroke="#9290FF" Width="29" Height="29" Margin="0,0,10,0"/><TextBlock Text="ListFXFlow" FontSize="21" FontWeight="Bold"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,35,0,0">
          <Border Background="#26243F" CornerRadius="10" Padding="14"><StackPanel Orientation="Horizontal"><local:FlowIcon Kind="Workspace" Stroke="#9290FF" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="工作空间" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
          <StackPanel Orientation="Horizontal" Margin="14,20,0,0"><local:FlowIcon Kind="Bolt" Stroke="#858C9F" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="雷雳直连" Foreground="#858C9F" VerticalAlignment="Center"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="3"><TextBlock Text="让设备之间，没有边界。" FontSize="11" Foreground="#858C9F"/><TextBlock Text="{x:Static local:BuildInfo.Label}" FontFamily="Consolas" FontSize="10" Foreground="#575F76" Margin="0,15,0,0" LineHeight="17"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,29,30,24">
        <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="一个光标，两个世界" FontSize="29" FontWeight="Bold"/><TextBlock Text="跨过屏幕边缘，接着做你的事。" Foreground="#858C9F" Margin="0,9,0,0"/></StackPanel>
          <Border Grid.Column="1" Background="#191D29" CornerRadius="17" Padding="14,9" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="10" Height="10" Stroke="#858C9F" StrokeThickness="1.5" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionBadge" Text="未连接" Foreground="#858C9F" FontSize="12"/></StackPanel></Border>
        </Grid>
        <Border Background="#141722" CornerRadius="17" BorderBrush="#242837" BorderThickness="1" Padding="20">
          <StackPanel>
            <Grid><TextBlock Text="屏幕排列" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="拖动 Windows 屏幕调整位置" Foreground="#858C9F" FontSize="11" HorizontalAlignment="Right"/></Grid>
            <Border Background="#0F121C" CornerRadius="12" Margin="0,18,0,16">
              <Canvas x:Name="Diagram" Height="245" ClipToBounds="True" Background="{StaticResource DotGrid}" SizeChanged="DiagramSizeChanged">
                <Border x:Name="MacDevice" Background="#29274C" BorderBrush="#9290FF" BorderThickness="1.5" CornerRadius="11">
                  <Viewbox Stretch="Uniform" Margin="10" MaxWidth="180" MaxHeight="94"><StackPanel Width="150" VerticalAlignment="Center" HorizontalAlignment="Center"><local:FlowIcon Kind="Desktop" Stroke="#DBD8FF" Width="29" Height="29" HorizontalAlignment="Center"/><TextBlock Text="Mac" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="远端 · 主显示器" Foreground="#9A9BB8" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Viewbox>
                </Border>
                <Border x:Name="WindowsDevice" Background="#222637" BorderBrush="#464B66" BorderThickness="1" CornerRadius="11" Cursor="SizeAll" MouseLeftButtonDown="DragStart" MouseMove="DragMove" MouseLeftButtonUp="DragEnd">
                  <Viewbox Stretch="Uniform" Margin="10" MaxWidth="180" MaxHeight="94"><StackPanel Width="150" VerticalAlignment="Center" HorizontalAlignment="Center"><local:FlowIcon Kind="Laptop" Stroke="#C5CBDD" Width="29" Height="29" HorizontalAlignment="Center"/><TextBlock Text="Windows" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="本机 · 主显示器" Foreground="#9A9BB8" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Viewbox>
                </Border>
              </Canvas>
            </Border>
          </StackPanel>
        </Border>
        <Grid Margin="0,17,0,17"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="#141722" CornerRadius="13" Padding="17"><StackPanel><StackPanel Orientation="Horizontal"><local:FlowIcon Kind="Keyboard" Stroke="#9290FF" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="键盘跟随光标" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="FocusText" Text="当前控制 · Windows" Foreground="#858C9F" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Grid.Column="2" Background="#141722" CornerRadius="13" Padding="17"><StackPanel><StackPanel Orientation="Horizontal"><local:FlowIcon Kind="Bolt" Stroke="#7AE3C1" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="雷雳有线连接" FontWeight="SemiBold" Foreground="#7AE3C1" VerticalAlignment="Center"/></StackPanel><TextBlock Text="自动发现 · 自动加密" Foreground="#858C9F" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Border Background="#141722" CornerRadius="17" Padding="20">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="连接设备" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="StatusText" Text="连接雷雳线，在 Mac 上启用共享。" Foreground="#929AAF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
              <Button Grid.Column="1" x:Name="ConnectButton" Content="连接 Mac" Click="ConnectClick" Background="{StaticResource Accent}" Foreground="#14142A" FontWeight="SemiBold" VerticalAlignment="Top" Padding="23,12"/>
            </Grid>
            <Border Height="1" Background="#282C3B" Margin="0,18,0,14"/>
            <TextBlock x:Name="ClipboardText" Text="剪贴板未连接" FontSize="11" Foreground="#7AE3C1" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Text="雷雳网卡" FontSize="11" Foreground="#929AAF" Margin="0,0,0,7"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="Adapters" ToolTip="选择 Thunderbolt / USB4 网络适配器" AutomationProperties.Name="雷雳网卡"/>
              <Button Grid.Column="1" Click="RefreshClick" ToolTip="刷新网卡" AutomationProperties.Name="刷新网卡" Background="Transparent" Padding="12,5"><local:FlowIcon Kind="Refresh" Stroke="#A9B1C9" Width="19" Height="19"/></Button>
            </Grid>
            <TextBlock Text="Mac IP" FontSize="11" Foreground="#929AAF" Margin="0,14,0,7"/>
            <Grid>
              <TextBox x:Name="MacAddress" AutomationProperties.Name="Mac IP，留空自动发现" ToolTip="填写 Mac 的雷雳 IPv4 地址，留空时自动发现"/>
              <TextBlock Text="留空自动发现，或输入 Mac 的雷雳 IP" Foreground="#747E96" FontSize="12" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=MacAddress}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
          </StackPanel>
        </Border>
        <Border Background="#141722" CornerRadius="13" Padding="17" Margin="0,17,0,0">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="游戏保护" Foreground="#DBD8FF" FontWeight="SemiBold"/>
                <TextBlock x:Name="GameStatus" Text="连接后可用" Foreground="#929AAF" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="GameLockButton" Content="锁定 Windows" IsEnabled="False" Click="GameLockClick" VerticalAlignment="Center" Background="Transparent" Padding="12,7"/>
            </Grid>
            <CheckBox x:Name="AutomaticGameProtection" Content="自动保护隐藏指针的全屏或捕获窗口" Checked="AutomaticGameProtectionChanged" Unchecked="AutomaticGameProtectionChanged" Foreground="#929AAF" FontSize="11" Margin="0,12,0,0"/>
            <TextBlock Text="Ctrl + Alt + L 锁定 / 解除 · 锁定期间停止跨屏" TextWrapping="Wrap" Foreground="#858C9F" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#141722" CornerRadius="13" Padding="17" Margin="0,17,0,0">
          <StackPanel>
            <TextBlock Text="本机触控板" Foreground="#DBD8FF" FontWeight="SemiBold"/>
            <TextBlock Text="控制 Mac 时自动屏蔽本机多指手势，返回 Windows 后恢复。" TextWrapping="Wrap" Foreground="#858C9F" FontSize="11" Margin="0,9,0,0"/>
            <CheckBox x:Name="ForwardMacGestures" Content="向 Mac 转发多指手势（实验）" Checked="ForwardMacGesturesChanged" Unchecked="ForwardMacGesturesChanged" Foreground="#929AAF" FontSize="11" Margin="0,12,0,0"/>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="TouchpadStatus" Text="连接后自动启用" TextWrapping="Wrap" Foreground="#929AAF" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button Grid.Column="1" Content="重试" Click="RetryTouchpadClick" Background="Transparent" Padding="9,5" ToolTip="重新尝试本机手势屏蔽"/>
            </Grid>
          </StackPanel>
        </Border>
        <DockPanel Margin="0,18,0,0"><TextBlock Text="Ctrl + Alt + Esc 随时停止共享" FontSize="10" Foreground="#5E6880"/><TextBlock Text="关闭窗口后继续在系统托盘运行" FontSize="10" Foreground="#5E6880" HorizontalAlignment="Right"/></DockPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
