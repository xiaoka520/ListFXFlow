<Window x:Class="ListFXFlow.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ListFXFlow" Title="安装 ListFXFlow" Width="680" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#0C0E15">
<Grid Margin="38"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><Border Background="#282442" CornerRadius="18" Padding="15" Width="70" Height="70" HorizontalAlignment="Left"><local:FlowIcon Kind="Pointer" Stroke="#A7A0FF" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="一个光标，两个世界" FontSize="28" FontWeight="Bold" Margin="0,23,0,8"/><TextBlock Text="安装 ListFXFlow，让键鼠与剪贴板跨越设备。" Foreground="#929AAF" FontSize="13"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,27,0,20"><TextBlock Text="安装到当前用户，无需管理员权限" FontSize="12"/><TextBlock x:Name="Location" Foreground="#747F99" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap"/><CheckBox x:Name="DesktopShortcut" IsChecked="True" Content="创建桌面快捷方式"/><CheckBox x:Name="RunAfter" IsChecked="True" Content="安装后运行，在系统托盘中保持共享"/><ProgressBar x:Name="Progress" Height="5" Foreground="#9690FF" Background="#222638" BorderThickness="0" Margin="0,17,0,12"/><TextBlock x:Name="Status" Text="关闭主窗口后继续在系统托盘运行。" Foreground="#929AAF" FontSize="12" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" Click="CloseClick" Margin="0,0,12,0"/><Button x:Name="InstallButton" Content="安装" Click="InstallClick" Background="#9290FF" Foreground="#111223" FontWeight="SemiBold"/></StackPanel>
</Grid>
</Window>
